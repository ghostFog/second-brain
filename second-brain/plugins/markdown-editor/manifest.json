{
  "name": "Markdown Editor",
  "id": "markdown-editor",
  "author": "第二脑",
  "icon": "file-text",
  "color": "#7C3AED",
  "cat": "editor",
  "desc": "Markdown 编辑器增强（vditor 底座由宿主承载）：注册 .md/.markdown 后缀，提供编辑/预览/分屏、右侧边面板（属性/大纲/反向链接/标签），并承载 markdown 专属增强——往返序列化、代码块语言选择器、WYSIWYG 块编辑、右键「插入图片/上传附件/在上方插入空行」、链接右键「浏览器打开/取消链接」、图片右键「下载/设置尺寸」、图片点击选中与拖拽调整尺寸、附件块非编辑卡片（整体插入/删除）。桌面版目录插件加载，网页版回落宿主薄壳。",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": ["md-serialize.js", "md-blocks.js", "md-context.js", "md-enhance.js", "md-attach.js"],
  "styles": "styles.css",
  "permissions": ["ui.editor"],
  "editor": {
    "extensions": [".md", ".markdown"],
    "openers": [
      { "id": "edit", "label": "编辑", "icon": "pencil" },
      { "id": "preview", "label": "预览", "icon": "eye" },
      { "id": "split", "label": "分屏", "icon": "columns-2" }
    ],
    "toolbar": [
      { "id": "mode-edit", "label": "编辑", "icon": "pencil", "mode": "edit" },
      { "id": "mode-preview", "label": "预览", "icon": "eye", "mode": "preview" },
      { "id": "mode-split", "label": "分屏", "icon": "columns-2", "mode": "split" },
      { "id": "toggle-source", "label": "源码/所见即所得", "icon": "code", "actionKey": "mde-toggle-source" },
      { "id": "toggle-lineno", "label": "行号", "icon": "list-ordered", "actionKey": "mde-toggle-lineno" },
      { "id": "toggle-wrap", "label": "自动换行", "icon": "wrap-text", "actionKey": "mde-toggle-wrap" },
      { "id": "view-index", "label": "索引面板", "icon": "database", "actionKey": "mde-view-index" },
      { "id": "delete", "label": "删除笔记", "icon": "trash-2", "actionKey": "mde-delete" }
    ],
    "sidebar": [
      { "id": "props", "label": "属性" },
      { "id": "outline", "label": "大纲" },
      { "id": "backlinks", "label": "反向链接" },
      { "id": "tags", "label": "标签" }
    ]
  },
  "commands": [
    { "icon": "file-text", "label": "Markdown: 打开当前笔记", "actionKey": "mde-open" },
    { "icon": "link", "label": "链接: 浏览器打开", "actionKey": "mde-link-open" },
    { "icon": "unlink", "label": "链接: 取消链接", "actionKey": "mde-link-unlink" },
    { "icon": "download", "label": "图片: 下载", "actionKey": "mde-img-download" },
    { "icon": "image", "label": "图片: 设置尺寸", "actionKey": "mde-img-size" }
  ],
  "contextMenus": {
    "editor": [
      { "label": "浏览器打开", "icon": "external-link", "actionKey": "mde-link-open" },
      { "label": "取消链接", "icon": "unlink", "actionKey": "mde-link-unlink" },
      { "label": "下载图片", "icon": "download", "actionKey": "mde-img-download" },
      { "label": "设置图片尺寸", "icon": "image", "actionKey": "mde-img-size" }
    ]
  }
}